#!/bin/bash
# omarchy plugin add only clones files, so this is the rest of the install:
# build the autoperf daemon and install it as a systemd user service.
#
#   ./setup              build and install (again after an update)
#   ./setup --uninstall  stop and remove the daemon (keeps the settings file)
#
# Everything installed is namespaced as omarchy-autoperf and marked as ours;
# anything at those paths without the mark is left alone rather than replaced.

set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)
plugin_id=$(jq -r .id "$root/manifest.json")
name=omarchy-autoperf
libdir="$HOME/.local/lib/$name"
bin="$libdir/autoperf"
owner_stamp="$libdir/.owner"
unit_name="$name.service"
unit="$HOME/.config/systemd/user/$unit_name"
# First line of daemon/omarchy-autoperf.service.
unit_marker="# Installed by the $plugin_id Omarchy plugin"

fail() {
  echo "setup: $*" >&2
  exit 1
}

# A path is ours when nothing is there yet, or it carries our mark: the unit's
# first line, or the stamp file in the binary's folder. Symlinks never are.
unit_owned() {
  [[ ! -e $unit && ! -L $unit ]] && return 0
  [[ ! -L $unit && -f $unit ]] && [[ $(head -n1 "$unit") == "$unit_marker" ]]
}

libdir_owned() {
  [[ ! -e $libdir && ! -L $libdir ]] && return 0
  [[ ! -L $libdir && -d $libdir && ! -L $owner_stamp && -f $owner_stamp ]] &&
    [[ $(<"$owner_stamp") == "$plugin_id" ]]
}

if [[ ${1:-} == --uninstall ]]; then
  if unit_owned; then
    if [[ -e $unit ]]; then
      systemctl --user disable --now "$unit_name" 2>/dev/null || true
      rm -f "$unit"
      systemctl --user daemon-reload
    fi
  else
    echo "setup: leaving $unit alone: it was not installed by this plugin" >&2
  fi
  if libdir_owned; then
    rm -rf "$libdir"
  else
    echo "setup: leaving $libdir alone: it was not installed by this plugin" >&2
  fi
  echo "Removed $name. Settings are left in ~/.config/$name/."
  exit 0
fi

# Check before building, so nothing is half-installed.
unit_owned || fail "$unit exists and was not installed by this plugin; move it away and run setup again"
libdir_owned || fail "$libdir exists and was not installed by this plugin; move it away and run setup again"

export PATH="$HOME/.cargo/bin:$PATH"
command -v cargo >/dev/null || omarchy pkg add rust

# Build outside the plugin folder: the shell reloads plugins on any file change
# under ~/.config/omarchy/plugins, and the checkout should stay clean for updates.
export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$name-build"
cargo build --release --locked --manifest-path "$root/daemon/Cargo.toml"

mkdir -p "$libdir"
printf '%s\n' "$plugin_id" >"$owner_stamp"
install -m755 "$CARGO_TARGET_DIR/release/autoperf" "$bin"
install -Dm644 "$root/daemon/$unit_name" "$unit"
systemctl --user daemon-reload

# Pick up the new binary if the service is already running
if systemctl --user is-active --quiet "$unit_name"; then
  systemctl --user restart "$unit_name"
fi

echo "$name is installed. Switch it on from its bar panel."
