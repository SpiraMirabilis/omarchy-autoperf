#!/bin/bash
# omarchy plugin add only clones files, so this is the rest of the install:
# build the autoperf daemon and install it as a systemd user service.
#
#   ./setup              build and install (again after an update)
#   ./setup --uninstall  stop and remove the daemon (keeps the settings file)

set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)
bin="$HOME/.local/bin/autoperf"
unit="$HOME/.config/systemd/user/autoperf.service"

if [[ ${1:-} == --uninstall ]]; then
  systemctl --user disable --now autoperf.service 2>/dev/null || true
  rm -f "$bin" "$unit"
  systemctl --user daemon-reload
  echo "Removed autoperf. Settings are left in ~/.config/autoperf/."
  exit 0
fi

export PATH="$HOME/.cargo/bin:$PATH"
command -v cargo >/dev/null || omarchy pkg add rust

# Build outside the plugin folder: the shell reloads plugins on any file change
# under ~/.config/omarchy/plugins, and the checkout should stay clean for updates.
export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/autoperf-build"
cargo build --release --locked --manifest-path "$root/daemon/Cargo.toml"

install -Dm755 "$CARGO_TARGET_DIR/release/autoperf" "$bin"
install -Dm644 "$root/daemon/autoperf.service" "$unit"
systemctl --user daemon-reload

# Pick up the new binary if the service is already running
if systemctl --user is-active --quiet autoperf.service; then
  systemctl --user restart autoperf.service
fi

echo "autoperf is installed. Switch it on from its bar panel."
